<clickhouse>
    <!-- MinIO Bronze bucket as a named collection: SQL uses s3(minio_bronze, filename='...').
         Keys are resolved from the container env (from .env via docker-compose), never written here. -->
    <named_collections>
        <minio_bronze>
            <url>http://minio:9000/bronze/</url>
            <access_key_id from_env="MINIO_ROOT_USER"/>
            <secret_access_key from_env="MINIO_ROOT_PASSWORD"/>
            <format>Parquet</format>
        </minio_bronze>
    </named_collections>
</clickhouse>
